{
  "name": "triptrace-research",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshots:generate": "node --conditions=react-server --import tsx scripts/generate-snapshots.ts",
    "snapshots:finalize-drafts": "node --conditions=react-server --import tsx scripts/finalize-snapshot-drafts.ts",
    "snapshots:continue": "node --conditions=react-server --import tsx scripts/continue-snapshot-drafts.ts"
  },
  "dependencies": {
    "lucide-react": "latest",
    "next": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "latest"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
