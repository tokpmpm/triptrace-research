# Copy this file to .env.local. Never commit .env.local.
OPENAI_API_KEY=
# Local development defaults to the cheaper GPT-5.4 nano model.
OPENAI_DEV_MODEL=gpt-5.4-nano
# Cloud Run sets TRIPTRACE_RUNTIME=production, which hard-locks gpt-5.6-luna.
TRIPTRACE_RUNTIME=development
# Optional zero-cost local UI/API fixture. Supports the bundled Taipei 101 demo.
TRIPTRACE_TEST_MODE=
YT_DLP_BIN=
# Optional: defaults to triptrace-research under the operating system temp directory.
TRIPTRACE_CACHE_DIR=
